@page
@model SportSynchro.IdentityServer.Pages.Login.Index

<div class="login-page">
    <div class="login-card">

        <div class="login-header">
            <h1>SportSynchro</h1>
            <p class="subtitle">Sign in to your account</p>
        </div>

        <partial name="_ValidationSummary" />

        @if (Model.View.EnableLocalLogin)
        {
            <form asp-page="/Account/Login/Index">
                <input type="hidden" asp-for="Input.ReturnUrl" />
                @if (string.IsNullOrEmpty(Model.Input.ReturnUrl))
                {
                    <div style="color:red">
                        ReturnUrl is EMPTY
                    </div>
                }

                <div class="form-group">
                    <label asp-for="Input.Username"></label>
                    <input class="form-control"
                           placeholder="Username"
                           asp-for="Input.Username"
                           autofocus />
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password"></label>
                    <input type="password"
                           class="form-control"
                           placeholder="Password"
                           asp-for="Input.Password"
                           autocomplete="off" />
                </div>

                @if (Model.View.AllowRememberLogin)
                {
                    <div class="form-options">
                        <label class="remember-me">
                            <input asp-for="Input.RememberLogin" />
                            Remember me
                        </label>
                    </div>
                }

                <button class="btn-primary"
                        name="Input.Button"
                        value="login">
                    Sign in
                </button>

                <button class="btn-secondary"
                        name="Input.Button"
                        value="cancel">
                    Cancel
                </button>
            </form>
        }

        @if (!Model.View.EnableLocalLogin && !Model.View.VisibleExternalProviders.Any())
        {
            <div class="alert alert-warning">
                <strong>Invalid login request</strong><br />
                There are no login schemes configured for this request.
            </div>
        }

        <div class="login-footer">
            <span>No account yet?</span>
            <a href="@Model.RegisterUrl">
                Create one
            </a>

        </div>

    </div>
</div>
