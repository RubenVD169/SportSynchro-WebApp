@page
@model SportSynchro.IdentityServer.Pages.Logout.LoggedOut

<div class="logout-page">
    <div class="logout-card">
        <h1>Signed out</h1>
        <p class="subtitle">You have been successfully logged out.</p>

        <p class="countdown-text">
            Redirecting to login in <span id="countdown">3</span>…
        </p>

        <p class="manual-link">
            Or click <a href="http://localhost:5173">here</a> to continue.
        </p>
    </div>
</div>

@section Scripts
{
    @if (Model.View.AutomaticRedirectAfterSignOut)
    {
        <script src="~/js/signout-redirect.js"></script>
    }
}
